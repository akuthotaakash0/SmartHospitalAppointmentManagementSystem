# Copy this file to .env and fill in your values
# For local development only — do NOT commit real secrets to git

# Flask secret key
SECRET_KEY=change_me_to_a_random_secret

# ---- Clerk Authentication (Optional but recommended) ----
# Get these from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated list of your frontend origins (for CSRF protection)
CLERK_AUTHORIZED_PARTIES=http://localhost:5000,https://your-app.vercel.app

# ---- Flask-Mail (Optional — configure if you want email notifications) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@hospital.com
